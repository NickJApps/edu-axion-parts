<!DOCTYPE html>
<html lang="en">

<!-- head include -->
<%- include('../layouts/head'); %>

<body>
    <!--Header include -->
    <%- include('../layouts/header'); %>

    <!--Modal Windows Include-->
    <%- include('../layouts/modals'); %>

    <main>

        <!--Hero Banner Include -->
        <%- include("../components/hero-banner") %>


        <section class="section search-section">
            <div class="search-container">
                <div class="search-by-partnumber">
                    <h3>Quick Search</h3>
                    <div class="subscribe-input-container">
                        <input type="text" placeholder="Write part number here...">
                        <button class="button subscribe-button" type="button">
                            <img src="../icons/find-product-icon.svg" alt="">
                        </button>
                    </div>
                </div>

                <div class="search-by-mark">
                    <h3>Vehicle Search</h3>
                    <div class="subscribe-input-container search-select">
                        <select name="mark" id="mark">
                            <option value="DEFAULT">Mark</option>
                            <option class="visibility" value="perro">Perro</option>
                            <option class="visibility" value="gato">Gato</option>
                            <option class="visibility" value="otro">Otro</option>
                        </select>
                        <select name="model" id="model">
                            <option value="DEFAULT">Model</option>
                        </select>
                        <select name="engine" id="endine">
                            <option value="DEFAULT">Engine</option>
                        </select>
                        <select name="year" id="year">
                            <option value="DEFAULT">Year</option>
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <section class="secction catalog">
            <div class="products">
                
                <% products.forEach(product => { %>

                    <%- include("../components/product-card", { product }) %>

                <% }) %>
                
            </div>
        </section>

    </main>

    

    <!--Footer include-->
    <%- include('../layouts/footer'); %>

    <!--Scrips include-->
    <%- include('../layouts/scripts'); %>
</body>

</html>