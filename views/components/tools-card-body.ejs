<div class="card-body">
    <div class="card-title card-title-tools">
        <img src="../../icons/key-icon.png" alt="">
        <span><%= product.partNumber %></span>
        <img src="../../icons/description-icon.png" alt="">
        <span><%= product.name %></span>
        <img src="../../icons/hammer-icon.png" alt="">
        <span><%= product.type %></span>
    </div>
    <div class="card-description">
        <div class="fluid-description">
            <p><%=product.description %></p>
        </div>
        <div class="product-type">
            <img src="../../icons/car-icon.png" alt="">
        </div>
    </div>
</div>