<div class="product-card">
    <div class="product-image">
        <img src=<%=product.image %> alt="">
    </div>
    
        <% if (product.category === "brake" || product.category === "clutch") { %>

            <%- include("parts-card-body", { product }) %>

        <% } else if (product.category === "fluid") { %>

            <%- include("fluid-card-body") %>

        <% } else if (product.category === "tools") { %>

            <%- include("tools-card-body") %>

        <% } %>



    <div class="card-price">
        <span>Price</span>
        <span>€ <%= product.price %></span>
    </div>
    <div class="card-buttons">
        <button type="button" class="button"><img src="../icons/favorite-icon.svg" alt=""></button>
        <button type="button" class="button"><img src="../icons/add-cart-icon.svg" alt=""></button>
    </div>
</div>