<div class="product-card">
    <div class="product-image">
        <img src=<%= product.image %> alt="">
    </div>
    <div class="card-body">
        <div class="card-title">
            <img src="../../icons/key-icon.png" alt="">
            <span><%= product.partNumber %></span>
            <img src="../../icons/description-icon.png" alt="">
            <span><%= product.name %></span>
        </div>
        <div class="card-description">
            <div class="product-mark">
                <span>Mark</span>
                <span><%= product.mark %></span>
            </div>
            <div class="product-model">
                <span>Model</span>
                <span><%= product.model %></span>
            </div>
            <div class="product-year">
                <span>Year</span>
                <span><%= product.year %></span>
            </div>
            <div class="product-type">
                <img src="../../icons/car-icon.png" alt="">
            </div>
            <div class="product-price">
                <span>Price</span>
                <span>€ <%= product.price %></span>
            </div>
        </div>
    </div>
    <div class="card-buttons">
        <button type="button" class="button"><img src="../icons/favorite-icon.svg" alt=""></button>
        <button type="button" class="button"><img src="../icons/add-cart-icon.svg" alt=""></button>
    </div>
</div>