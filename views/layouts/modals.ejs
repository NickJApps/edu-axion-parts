<!--Register Modal-->
<div class="modal" id="register">
    <div class="modal-container">
        <div class="modal-header">
            <h2>Register New Account</h2>
            <p>Suspen dise tempus oncu enim pellen teste pretium.</p>
        </div>
        <form class="modal-content">
            <div class="form-group input-user"><input type="text" placeholder="Your name"></div>
            <div class="form-group input-phone"><input type="tel" placeholder="Your phone"></div>
            <div class="form-group input-email"><input type="email" placeholder="Your e-mail"></div>
            <div class="form-group input-password"><input type="text" placeholder="Password"></div>
            <div class="form-group input-repeat"><input type="text" placeholder="Password Repeat"></div>
            <button class="button" id="registerButton" type="submit">Register</button>
        </form>
    </div>
</div>

<!--SignIn Modal-->
<div class="modal" id="login">
    <div class="modal-container">
        <div class="modal-header">
            <h2>Login to account </h2>
            <p>Suspen dise tempus oncu enim pellen teste pretium.</p>
        </div>
        <form class="modal-content">
            <div class="form-group input-user"><input type="text" placeholder="Your name"></div>
            <div class="form-group input-password"><input type="text" placeholder="Password"></div>
            <button class="button" type="submit">Login</button>
        </form>
    </div>
</div>